{
  "name": "trasluz",
  "private": true,
  "version": "0.1.0",
  "description": "Trasluz — liquidación B2B confidencial sobre Avalanche eERC con ventana de auditoría",
  "scripts": {
    "compile": "pnpm --filter @trasluz/contracts compile",
    "test": "pnpm --filter @trasluz/contracts test",
    "node": "pnpm --filter @trasluz/contracts node",
    "deploy:local": "pnpm --filter @trasluz/contracts deploy:local",
    "deploy:fuji": "pnpm --filter @trasluz/contracts deploy:fuji",
    "e2e:local": "pnpm --filter @trasluz/contracts e2e:local",
    "e2e:fuji": "pnpm --filter @trasluz/contracts e2e:fuji",
    "verify-vendor": "pnpm --filter @trasluz/contracts verify-vendor",
    "dev": "pnpm --filter @trasluz/web dev",
    "build": "pnpm --filter @trasluz/web build",
    "preview": "pnpm --filter @trasluz/web preview",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
