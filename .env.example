# ── Contratos (Hardhat) ─────────────────────────────────────────────
# Deployer / owner del SettlementManager en Fuji (necesita AVAX de testnet).
DEPLOYER_PRIVATE_KEY=
# Opcional: EOA del auditor designado. Si falta, el deploy genera una y la fondea.
AUDITOR_PRIVATE_KEY=
# Opcional: entidades KYC a habilitar en el deploy (separadas por coma).
KYC_ADDRESSES=
# Opcional: RPC de Fuji propio (el oficial limita getLogs a 100 bloques por request).
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# ── Frontend (Vite) — copiar a web/.env.local ───────────────────────
# WalletConnect (QR para wallets de celular): project ID de cloud.reown.com, con el dominio en su allowlist.
# VITE_WALLETCONNECT_PROJECT_ID=
# VITE_FUJI_RPC_URL=
